# Mecris MCP Server Configuration

# Operating Mode: standalone (local SQLite) or multi-tenant (Neon Postgres + JWT)
MECRIS_MODE=standalone

# Pocket ID OIDC Configuration
POCKET_ID_CLIENT_ID=21f65a91-c4df-468d-a256-3b66a54c6d5f
POCKET_ID_REDIRECT_URI=http://localhost:54321

# Server Configuration
PORT=8000
DEBUG=false

# Database Configuration
# Neon Database URL (Required for multi-tenant mode or cloud sync)
NEON_DB_URL="postgresql://user:pass@host/neondb"

# Obsidian MCP Integration
OBSIDIAN_MCP_HOST=localhost
OBSIDIAN_MCP_PORT=3001
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Beeminder API Configuration
BEEMINDER_USERNAME=your_username
BEEMINDER_AUTH_TOKEN=your_auth_token
BEEMINDER_API_BASE=https://www.beeminder.com/api/v1

# Twilio SMS Configuration (from twilio_sender.py)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+1987654321
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Reminder Delivery Configuration
REMINDER_DELIVERY_METHOD=console  # Options: console, sms, whatsapp, both
REMINDER_ENABLE_FALLBACK=true     # If primary method fails, try alternatives
REMINDER_TEST_MODE=false          # If true, messages go to console instead of delivery

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=mecris.log

# Claude Usage Monitoring (placeholder for future)
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_BUDGET_LIMIT=1.00
CLAUDE_USAGE_ALERT_THRESHOLD=0.80

# Helix billing odometer (task 588): read-only Helix API key (hl-...) created at
# app.helix.ml -> Settings -> API keys. Provisioned like the master-key pattern
# (1Password item -> .env / Spin Variables). NEVER commit the real value.
#HELIX_BILLING_API_TOKEN=hl-xxxxxxxx
#HELIX_API_BASE_URL=https://app.helix.ml   # default; override only for testing
#HELIX_BILLING_ORG_ID=mecris               # org whose wallet we chart
#HELIX_BEEMINDER_GOAL=helix-ml             # goal the straight-copy datapoints land on
#HELIX_MONTHLY_GRANT=100                   # F&F grant, feeds the pump-pace scalar
#HELIX_BURN_CAP=5                          # know-better sanity ceiling (human-raiseable, machine-never)
#HELIX_BURN_FLOOR=1                        # keep-the-pulse floor (Beeminder road pressure)
